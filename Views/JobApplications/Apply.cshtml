@model WebAppJobSearchOnline.Data.JobApplication

@{
    ViewData["Title"] = "Job Applications - Apply";
}

<h4>Apply for @ViewBag.JobTitle</h4>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Apply" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" name="JobPostingId" value="@ViewBag.JobPostingId" />

            <div class="form-group mb-3">
                <label class="control-label">Upload Your CV</label>
                <input type="file" name="cvFile" class="form-control" accept=".pdf,.doc,.docx" />
                <span class="text-muted">Accepted formats: PDF, DOC, DOCX (Max size: 5MB)</span>
                <span asp-validation-for="CVFilePath" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Submit Application" class="btn btn-primary" />
                <a asp-action="Index" asp-controller="JobApplications" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
