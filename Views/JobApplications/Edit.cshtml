@model WebAppJobSearchOnline.Data.JobApplication
@using WebAppJobSearchOnline.Constants

@{
    ViewData["Title"] = "Job Applications - Edit";
}

<h4>Job Applications - Edit</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CVFilePath" />
            <input type="hidden" asp-for="CVFileName" />
            <input type="hidden" asp-for="CVFileType" />
            <div class="form-group">
                <label asp-for="JobPostingId" class="control-label"></label>
                <input asp-for="JobPostingId" class="form-control" readonly />
                <span asp-validation-for="JobPostingId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="UserId" class="control-label"></label>
                <input asp-for="UserId" class="form-control" readonly />
                <span asp-validation-for="UserId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Status" class="control-label"></label>
                @if (User.IsInRole("Admin"))
				{
                    <select asp-for="Status" class="form-control" asp-items="@(new SelectList(new List<string> {ApplicationStatus.Applied, ApplicationStatus.Interviewing, ApplicationStatus.Accepted, ApplicationStatus.Rejected, ApplicationStatus.Withdrawn }))">
                        <option value="">-- Select Status --</option>
                    </select>
                }
                else @if (User.IsInRole("User"))
                {
                    <select asp-for="Status" class="form-control" asp-items="@(new SelectList(new List<string> {ApplicationStatus.Applied, ApplicationStatus.Withdrawn }))">
                        <option value="">-- Select Status --</option>
                    </select>
                }                
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AppliedDate" class="control-label"></label>
                <input asp-for="AppliedDate" class="form-control" readonly />
                <span asp-validation-for="AppliedDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
