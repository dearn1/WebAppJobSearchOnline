@model WebAppJobSearchOnline.Data.JobPosting

@{
    ViewData["Title"] = "Job Postings - Details";
}

<div>
    <h4>Job Postings - Details</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Title)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Title)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Requirements)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Requirements)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Location)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Location)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.SalaryMin)
        </dt>
        <dd class = "col-sm-10">
            @String.Format("{0:C}", Model.SalaryMin) <!-- Format as currency (NZD) -->
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.SalaryMax)
        </dt>
        <dd class = "col-sm-10">
            @String.Format("{0:C}", Model.SalaryMax) <!-- Format as currency (NZD) -->
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.JobType)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.JobType)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Status)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.StartPosting)
        </dt>
        <dd class = "col-sm-10">
            @Model.StartPosting.ToString("dd-MMM-yyyy") <!-- Custom date format -->
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.EndPosting)
        </dt>
        <dd class = "col-sm-10">
            @Model.EndPosting.ToString("dd-MMM-yyyy") <!-- Custom date format -->
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
